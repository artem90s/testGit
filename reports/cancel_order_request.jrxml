<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by GPT-5: Cancel previously submitted order (Поручение на отмену ранее поданного поручения) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="cancel_order_request"
              language="java"
              pageWidth="595" pageHeight="842" columnWidth="523"
              leftMargin="36" rightMargin="36" topMargin="24" bottomMargin="24"
              whenNoDataType="NoDataSection">

  <!-- Base styles with Cyrillic-friendly fonts -->
  <style name="base" fontName="DejaVu Sans" fontSize="10"
         pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
  <style name="title" style="base" fontSize="12" isBold="true"/>
  <style name="small" style="base" fontSize="8"/>
  <style name="label" style="base" isBold="true"/>
  <style name="center" style="base" textAlignment="Center"/>

  <!-- Parameters (strings to avoid locale issues; format outside or pass ready strings) -->
  <parameter name="companyRecipient" class="java.lang.String">
    <defaultValueExpression><![CDATA["В ДЕПОЗИТАРИЙ ВЭБ.РФ"]]></defaultValueExpression>
  </parameter>
  <parameter name="docNumber" class="java.lang.String"/>
  <parameter name="docDateText" class="java.lang.String"/>
  <parameter name="depositorName" class="java.lang.String"/>
  <parameter name="cancelOrderNumber" class="java.lang.String"/>
  <parameter name="cancelOrderDateText" class="java.lang.String"/>
  <parameter name="depoAccountNumber" class="java.lang.String"/>
  <parameter name="settlementDateText" class="java.lang.String"/>
  <parameter name="amountText" class="java.lang.String"/>
  <parameter name="creditToWebrf" class="java.lang.Boolean">
    <defaultValueExpression><![CDATA[false]]></defaultValueExpression>
  </parameter>
  <parameter name="webrfAccountNumber" class="java.lang.String"/>
  <parameter name="transferToOtherBank" class="java.lang.Boolean">
    <defaultValueExpression><![CDATA[false]]></defaultValueExpression>
  </parameter>
  <parameter name="bankRequisites" class="java.lang.String"/>
  <parameter name="position" class="java.lang.String"/>
  <parameter name="signatureName" class="java.lang.String"/>
  <parameter name="acceptDateTimeText" class="java.lang.String"/>
  <parameter name="incomingNumber" class="java.lang.String"/>

  <background>
    <band height="1"/>
  </background>

  <detail>
    <band height="720">

      <!-- Top right recipient -->
      <textField>
        <reportElement x="323" y="0" width="200" height="16" style="base"/>
        <textElement textAlignment="Right"/>
        <textFieldExpression><![CDATA[$P{companyRecipient}]]></textFieldExpression>
      </textField>

      <!-- Title -->
      <staticText>
        <reportElement x="0" y="28" width="523" height="20" style="title"/>
        <textElement textAlignment="Center"/>
        <text><![CDATA[ПОРУЧЕНИЕ НА ОТМЕНУ РАНЕЕ ПОДАННОГО ПОРУЧЕНИЯ]]></text>
      </staticText>

      <!-- Number and date line -->
      <textField>
        <reportElement x="0" y="52" width="523" height="16" style="center"/>
        <textFieldExpression><![CDATA[("№ " + ($P{docNumber} == null ? "______" : $P{docNumber}) +
          " от " + ($P{docDateText} == null ? "«__» __________ 20__ г." : $P{docDateText}))]]></textFieldExpression>
      </textField>

      <!-- Long line under header -->
      <line>
        <reportElement x="0" y="76" width="523" height="1"/>
      </line>

      <!-- Depositor name fill line -->
      <textField>
        <reportElement x="0" y="88" width="523" height="16" style="base"/>
        <textFieldExpression><![CDATA[$P{depositorName} == null ? "" : $P{depositorName}]]></textFieldExpression>
      </textField>
      <line>
        <reportElement x="0" y="106" width="523" height="1"/>
      </line>
      <staticText>
        <reportElement x="0" y="109" width="523" height="12" style="small"/>
        <textElement textAlignment="Center"/>
        <text><![CDATA[(полное или краткое официальное наименование/Ф.И.О. Депонента)]]></text>
      </staticText>

      <!-- Body paragraph: cancel request -->
      <textField isStretchWithOverflow="true">
        <reportElement x="0" y="132" width="523" height="34" style="base"/>
        <textFieldExpression><![CDATA[
          "просит отменить поручение № " + ($P{cancelOrderNumber}==null?"______":$P{cancelOrderNumber}) +
          " от " + ($P{cancelOrderDateText}==null?"«__» __________ 20__ г.":$P{cancelOrderDateText}) +
          " по счету депо № " + ($P{depoAccountNumber}==null?"______":$P{depoAccountNumber}) +
          ", с датой расчетов " + ($P{settlementDateText}==null?"«__» __________ 20__ г.":$P{settlementDateText}) + "." ]]> </textFieldExpression>
      </textField>

      <!-- Simultaneous request paragraph with amount and footnote markers using simple HTML for superscripts -->
      <textField isStretchWithOverflow="true">
        <reportElement x="0" y="172" width="523" height="32" style="base"/>
        <textElement markup="html"/>
        <textFieldExpression><![CDATA[
          "Одновременно просим денежные средства, зарезервированные для исполнения отменяемого поручения, в сумме " +
          ($P{amountText}==null?"__________":$P{amountText}) + "<sup>2</sup>" ]]> </textFieldExpression>
      </textField>

      <!-- Option 1: credit to WEB.RF account (checkbox + text) -->
      <rectangle>
        <reportElement x="6" y="214" width="12" height="12"/>
      </rectangle>
      <textField>
        <reportElement x="6" y="214" width="12" height="12" style="center"/>
        <textFieldExpression><![CDATA[$P{creditToWebrf} != null && $P{creditToWebrf} ? "✓" : ""]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true">
        <reportElement x="24" y="212" width="499" height="16" style="base"/>
        <textFieldExpression><![CDATA[
          "зачислить на банковский счет Депонента в ВЭБ.РФ № " + ($P{webrfAccountNumber}==null?"__________":$P{webrfAccountNumber})
        ]]> </textFieldExpression>
      </textField>

      <!-- Option 2: transfer to given bank requisites -->
      <rectangle>
        <reportElement x="6" y="236" width="12" height="12"/>
      </rectangle>
      <textField>
        <reportElement x="6" y="236" width="12" height="12" style="center"/>
        <textFieldExpression><![CDATA[$P{transferToOtherBank} != null && $P{transferToOtherBank} ? "✓" : ""]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="24" y="234" width="499" height="16" style="base"/>
        <text><![CDATA[перевести согласно следующими банковскими реквизитам:]]></text>
      </staticText>

      <!-- Multiline bank requisites area -->
      <rectangle>
        <reportElement x="0" y="254" width="523" height="66"/>
      </rectangle>
      <textField isStretchWithOverflow="true">
        <reportElement x="4" y="258" width="515" height="58" style="base"/>
        <textFieldExpression><![CDATA[$P{bankRequisites}==null?"":$P{bankRequisites}]]></textFieldExpression>
      </textField>

      <!-- Signatures row: three lines -->
      <!-- Position (left) -->
      <line>
        <reportElement x="0" y="336" width="160" height="1"/>
      </line>
      <textField>
        <reportElement x="0" y="318" width="160" height="16" style="center"/>
        <textFieldExpression><![CDATA[$P{position}==null?"":$P{position}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="0" y="340" width="160" height="12" style="small"/>
        <textElement textAlignment="Center"/>
        <text><![CDATA[(должность)]]></text>
      </staticText>

      <!-- Signature (middle) -->
      <line>
        <reportElement x="182" y="336" width="160" height="1"/>
      </line>
      <staticText>
        <reportElement x="182" y="340" width="160" height="12" style="small"/>
        <textElement textAlignment="Center"/>
        <text><![CDATA[(подпись)]]></text>
      </staticText>

      <!-- Full name (right) -->
      <line>
        <reportElement x="364" y="336" width="159" height="1"/>
      </line>
      <textField>
        <reportElement x="364" y="318" width="159" height="16" style="center"/>
        <textFieldExpression><![CDATA[$P{signatureName}==null?"":$P{signatureName}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement x="364" y="340" width="159" height="12" style="small"/>
        <textElement textAlignment="Center"/>
        <text><![CDATA[(Ф.И.О.)]]></text>
      </staticText>

      <!-- Seal label M.P. -->
      <staticText>
        <reportElement x="250" y="356" width="40" height="12" style="small"/>
        <textElement textAlignment="Center"/>
        <text><![CDATA[М.П.]]></text>
      </staticText>

      <!-- Divider line -->
      <line>
        <reportElement x="0" y="394" width="523" height="1"/>
      </line>

      <!-- Depositary notes -->
      <staticText>
        <reportElement x="0" y="402" width="523" height="14" style="center"/>
        <text><![CDATA[Отметки Депозитария]]></text>
      </staticText>

      <!-- Bottom table: date/time + incoming number -->
      <rectangle>
        <reportElement x="0" y="422" width="523" height="46"/>
      </rectangle>

      <staticText>
        <reportElement x="8" y="430" width="230" height="12" style="small"/>
        <text><![CDATA[Дата и время приема поручения:]]></text>
      </staticText>
      <textField>
        <reportElement x="8" y="444" width="260" height="14" style="base"/>
        <textFieldExpression><![CDATA[$P{acceptDateTimeText}==null?"«__» __________ 20__ г., __:__":$P{acceptDateTimeText}]]></textFieldExpression>
      </textField>

      <staticText>
        <reportElement x="290" y="430" width="60" height="12" style="small"/>
        <text><![CDATA[Вх. №]]></text>
      </staticText>
      <textField>
        <reportElement x="350" y="430" width="165" height="14" style="base"/>
        <textFieldExpression><![CDATA[$P{incomingNumber}==null?"":$P{incomingNumber}]]></textFieldExpression>
      </textField>

    </band>
  </detail>

  <noData>
    <band height="1"/>
  </noData>
</jasperReport>
